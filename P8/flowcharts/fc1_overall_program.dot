digraph G { graph [fontname="Helvetica", nodesep=0.4, ranksep=0.4]; node [fontname="Helvetica", fontsize=11, style=filled, fillcolor=white]; edge [fontname="Helvetica", fontsize=10];
 labelloc=t; label="Fig 1. Overall program flow (main.cpp)"; fontsize=14;
 start [label="Start", shape=oval, fillcolor="#d9ead3"];
 open  [label="Open results.txt\n(console + file output)", shape=box];
 menu  [label="Display menu\nRead choice", shape=parallelogram];
 d     [label="Choice?", shape=diamond, fillcolor="#fff2cc"];
 c1 [label="1: PageRank\nread file name + damping d", shape=parallelogram];
 p1 [label="Graph::load()\n(see Fig 2)", shape=box];
 ok1 [label="Load OK and\n0 < d < 1 ?", shape=diamond, fillcolor="#fff2cc"];
 r1 [label="runPageRank()\n(see Fig 3)", shape=box];
 c4 [label="4: Damping study\nread file name", shape=parallelogram];
 r4 [label="Graph::load(), then pagerank()\nfor d = 0.5, 0.7, 0.85, 0.95, 0.99\nprint iterations / time", shape=box];
 c2 [label="2: Markov\nread matrix file + lazy y/n", shape=parallelogram];
 ok2 [label="loadMarkov()\nsucceeded?", shape=diamond, fillcolor="#fff2cc"];
 r2 [label="analyzeMarkov()\n(see Fig 4)", shape=box];
 c3 [label="3: Built-in test suite\n(6 tests + periodic fix)", shape=box];
 c5 [label="5: Generate random\ngraph file", shape=box];
 err [label="Print error message", shape=box, fillcolor="#f4cccc"];
 stop [label="Close files\nEnd", shape=oval, fillcolor="#f4cccc"];
 start -> open -> menu -> d;
 d -> c1 [label="1"]; d -> c2 [label="2"]; d -> c3 [label="3"]; d -> c4 [label="4"]; d -> c5 [label="5"];
 d -> stop [label="0"];
 c1 -> p1 -> ok1; ok1 -> r1 [label="yes"]; ok1 -> err [label="no"];
 c4 -> r4;
 c2 -> ok2; ok2 -> r2 [label="yes"]; ok2 -> err [label="no"];
 back [label="A", shape=circle, width=0.35, fixedsize=true, fillcolor="#d9d9d9"];
 r1 -> back; r4 -> back; r2 -> back; c3 -> back; c5 -> back; err -> back;
 back -> menu [constraint=false, label="return to menu"];
}
