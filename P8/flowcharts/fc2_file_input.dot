digraph G { graph [fontname="Helvetica", nodesep=0.4, ranksep=0.4]; node [fontname="Helvetica", fontsize=11, style=filled, fillcolor=white]; edge [fontname="Helvetica", fontsize=10];
 labelloc=t; label="Fig 2. Edge-list file input and linked-list construction (Graph::load)"; fontsize=14;
 s [label="Start\nload(fname)", shape=oval, fillcolor="#d9ead3"];
 o [label="Open file", shape=box];
 f1 [label="Opened?", shape=diamond, fillcolor="#fff2cc"];
 e1 [label="Return error:\ncannot open file", shape=box, fillcolor="#f4cccc"];
 rd [label="Read next line;\nstrip text after '#'", shape=parallelogram];
 eof [label="End of file?", shape=diamond, fillcolor="#fff2cc"];
 blank [label="Line empty?", shape=diamond, fillcolor="#fff2cc"];
 fmt [label="Exactly two integers\nu, v with 0 <= u,v <= 10^7 ?", shape=diamond, fillcolor="#fff2cc"];
 warn [label="Print warning;\nbad = bad + 1", shape=box, fillcolor="#fce5cd"];
 store [label="Save (u, v) in temporary list\nmaxId = max(maxId, u, v)", shape=box];
 any [label="Any valid edge?", shape=diamond, fillcolor="#fff2cc"];
 e2 [label="Return error:\nno valid edges", shape=box, fillcolor="#f4cccc"];
 init [label="N = maxId + 1\nCreate array of N nodes\n(head = NULL, outdeg = 0)", shape=box];
 add [label="Take next saved (u, v)\nand call addEdge(u, v)", shape=box];
 more [label="More saved\nedges?", shape=diamond, fillcolor="#fff2cc"];
 chk [label="u = v, or v already\nin list of u ?", shape=diamond, fillcolor="#fff2cc"];
 skip [label="Ignore (count as duplicate/self link)", shape=box, fillcolor="#fce5cd"];
 ins [label="new Edge{to = v}\ninsert at head of list u\noutdeg[u]++, edges++", shape=box];
 done [label="All edges added;\nprint summary\nReturn success", shape=oval, fillcolor="#d9ead3"];
 s -> o -> f1; f1 -> e1 [label="no"]; f1 -> rd [label="yes"];
 rd -> eof; eof -> any [label="yes"]; eof -> blank [label="no"];
 blank -> rd [label="yes"]; blank -> fmt [label="no"];
 fmt -> store [label="yes"]; fmt -> warn [label="no"];
 store -> rd; warn -> rd;
 any -> e2 [label="no"]; any -> init [label="yes"]; init -> add -> chk;
 chk -> skip [label="yes"]; chk -> ins [label="no"];
 skip -> more; ins -> more; more -> add [label="yes"]; more -> done [label="no"];
}
