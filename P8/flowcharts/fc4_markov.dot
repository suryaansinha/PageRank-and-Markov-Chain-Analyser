digraph G { graph [fontname="Helvetica", nodesep=0.4, ranksep=0.4]; node [fontname="Helvetica", fontsize=11, style=filled, fillcolor=white]; edge [fontname="Helvetica", fontsize=10];
 labelloc=t; label="Fig 4. Markov chain steady state and n-step comparison (analyzeMarkov())"; fontsize=14;
 s [label="Start\ninput: P (n x n), initial pi0, lazy flag", shape=oval, fillcolor="#d9ead3"];
 v [label="Rows non-negative and\neach sums to 1 ?\npi0 valid ?", shape=diamond, fillcolor="#fff2cc"];
 err [label="Print error\nreturn", shape=box, fillcolor="#f4cccc"];
 lz [label="lazy = yes ?", shape=diamond, fillcolor="#fff2cc"];
 lzp [label="P = (P + I) / 2", shape=box];
 ex [label="Exact steady state:\nsolve pi(P - I) = 0, sum(pi) = 1\n(Gaussian elimination, partial pivoting)", shape=box];
 sing [label="Pivot ~ 0 ?\n(singular)", shape=diamond, fillcolor="#fff2cc"];
 note [label="Note: no unique\nsteady state", shape=box, fillcolor="#fce5cd"];
 pm [label="Power method:\nx = pi0, it = 1", shape=box];
 st [label="y = x * P\nnormalise y to sum 1\ndiff = sum |y - x|;  x = y", shape=box];
 cv [label="diff < 1e-12 ?", shape=diamond, fillcolor="#fff2cc"];
 mx [label="it = 100000 ?", shape=diamond, fillcolor="#fff2cc"];
 inc [label="it = it + 1", shape=box];
 fail [label="Report non-convergence\n(periodic / reducible chain)\nsuggest lazy option", shape=box, fillcolor="#f4cccc"];
 good [label="Report iterations and time", shape=box, fillcolor="#d9ead3"];
 tab [label="Print table: power method vs exact, absolute error", shape=parallelogram];
 ns [label="n-step method: v = pi0\nfor n = 1 .. 200: v = v * P\nrecord L1 error |v - pi| ;  print at n = 1,2,3,5,10,20,50,100,200", shape=box];
 csv [label="Save markov_nstep.csv,\nmarkov_power_convergence.csv", shape=parallelogram];
 e [label="End", shape=oval, fillcolor="#d9ead3"];
 s -> v; v -> err [label="no"]; v -> lz [label="yes"];
 lz -> lzp [label="yes"]; lz -> ex [label="no"]; lzp -> ex;
 ex -> sing; sing -> note [label="yes"]; sing -> pm [label="no"]; note -> pm;
 pm -> st -> cv; cv -> good [label="yes"]; cv -> mx [label="no"];
 mx -> fail [label="yes"]; mx -> inc [label="no"]; inc -> st;
 good -> tab; fail -> tab; tab -> ns -> csv -> e;
}
